VM_NAME="school-app-host-vm"
ZONE="us-central1-a"
MACHINE_TYPE="e2-micro"
LABELS="environment=dev,app=frontend,team=school,project=schoolproject"
TAGS="school-app-vm,web-app,schoolproject,http-server,https-server"

#Environment Variables for the Web App
REQUIRED_SECRETS="SCHOOL_WEB_APP_DB_URL,SCHOOL_WEB_APP_AUTH_SECRET"

# OS Configuration
IMAGE_FAMILY="debian-12"
IMAGE_PROJECT="debian-cloud"

# Optional Startup Script to Clone & Run Web App
STARTUP_SCRIPT_PATH="scripts/school-web-app/startupScript.sh"
VM_NAME="pg-db-host-vm"
ZONE="us-central1-a"
MACHINE_TYPE="e2-small"
LABELS="environment=dev,app=db,team=school,project=schoolproject,resource=postgres-db"
TAGS="pg-db-host-vm,postgres-db,schoolproject"

# OS Configuration 
IMAGE_FAMILY="debian-12"
IMAGE_PROJECT="debian-cloud"

# Optional Disk configuration
ATTACH_DISK="true"
DISK_NAME="pg-dev-schooldb"
DISK_SIZE="10GB"
DISK_TYPE="pd-standard"

# Optional Startup Script
STARTUP_SCRIPT_PATH="scripts/pg-school-db/startUpScript.sh"